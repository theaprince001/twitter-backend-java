<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-users-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="users"/></not>
        </preConditions>
        <createTable tableName="users">
            <column name="id" type="BINARY(16)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="username" type="VARCHAR(30)"><constraints unique="true" nullable="false"/></column>
            <column name="name" type="VARCHAR(50)"><constraints nullable="false"/></column>
            <column name="avatar" type="VARCHAR(255)"/>
            <column name="email" type="VARCHAR(255)"><constraints unique="true"/></column>
            <column name="password" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="bio" type="VARCHAR(240)"/>
            <column name="follower_count" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="following_count" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="verified" type="BIT" defaultValueBoolean="false"><constraints nullable="false"/></column>
            <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
            <column name="updated_at" type="DATETIME(6)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="001b-create-users-name-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="users" indexName="idx_users_name"/></not>
        </preConditions>
        <createIndex tableName="users" indexName="idx_users_name">
            <column name="name"/>
        </createIndex>
    </changeSet>

    <changeSet id="001c-create-users-bio-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="users" indexName="idx_users_bio"/></not>
        </preConditions>
        <createIndex tableName="users" indexName="idx_users_bio">
            <column name="bio"/>
        </createIndex>
    </changeSet>

    <changeSet id="002-create-posts-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="posts"/></not>
        </preConditions>
        <createTable tableName="posts">
            <column name="id" type="BINARY(16)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="users_id" type="BINARY(16)"><constraints nullable="false" foreignKeyName="fk_posts_users_id" references="users(id)"/></column>
            <column name="text" type="VARCHAR(240)"/>
            <column name="like_count" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="repost_count" type="BIGINT" defaultValueNumeric="0"><constraints nullable="false"/></column>
            <column name="orig_post_id" type="BINARY(16)"/>
            <column name="reply_to_id" type="BINARY(16)"/>
            <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
            <column name="updated_at" type="DATETIME(6)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="002b-create-posts-reply-to-created-at-id-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="posts" indexName="idx_posts_reply_to_created_at_id"/></not>
        </preConditions>
        <createIndex tableName="posts" indexName="idx_posts_reply_to_created_at_id">
            <column name="reply_to_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002c-create-posts-orig-post-id-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="posts" indexName="idx_posts_orig_post_id"/></not>
        </preConditions>
        <createIndex tableName="posts" indexName="idx_posts_orig_post_id">
            <column name="orig_post_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002d-create-posts-created-at-id-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="posts" indexName="idx_posts_created_at_id"/></not>
        </preConditions>
        <createIndex tableName="posts" indexName="idx_posts_created_at_id">
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="002e-create-posts-text-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="posts" indexName="idx_posts_text"/></not>
        </preConditions>
        <createIndex tableName="posts" indexName="idx_posts_text">
            <column name="text"/>
        </createIndex>
