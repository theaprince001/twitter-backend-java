    <changeSet id="003-create-posts-images-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="posts_images"/></not>
        </preConditions>
        <createTable tableName="posts_images">
            <column name="posts_id" type="BINARY(16)"><constraints nullable="false" primaryKey="true" foreignKeyName="fk_posts_images_posts" references="posts(id)"/></column>
            <column name="images" type="DATETIME(6)"/>
            <column name="images_key" type="VARCHAR(255)"><constraints primaryKey="true"/></column>
        </createTable>
    </changeSet>

    <changeSet id="004-create-posts-hashtags-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="posts_hashtags"/></not>
        </preConditions>
        <createTable tableName="posts_hashtags">
            <column name="posts_id" type="BINARY(16)"><constraints nullable="false" primaryKey="true" foreignKeyName="fk_posts_hashtags_posts" references="posts(id)"/></column>
            <column name="hashtags" type="DATETIME(6)"/>
            <column name="hashtags_key" type="VARCHAR(255)"><constraints primaryKey="true"/></column>
        </createTable>
    </changeSet>

    <changeSet id="005-create-posts-mentions-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="posts_mentions"/></not>
        </preConditions>
        <createTable tableName="posts_mentions">
            <column name="posts_id" type="BINARY(16)"><constraints nullable="false" primaryKey="true" foreignKeyName="fk_posts_mentions_posts" references="posts(id)"/></column>
            <column name="mentions" type="DATETIME(6)"/>
            <column name="mentions_key" type="VARCHAR(255)"><constraints primaryKey="true"/></column>
        </createTable>
    </changeSet>

    <changeSet id="006-create-follows-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="follows"/></not>
        </preConditions>
        <createTable tableName="follows">
            <column name="id" type="BINARY(16)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="follower_id" type="BINARY(16)"><constraints nullable="false" foreignKeyName="fk_follows_follower" references="users(id)"/></column>
            <column name="following_id" type="BINARY(16)"><constraints nullable="false" foreignKeyName="fk_follows_following" references="users(id)"/></column>
            <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
            <column name="updated_at" type="DATETIME(6)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="006b-add-follows-unique-constraint" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <or>
                <dbms type="!mysql"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM (
                    SELECT INDEX_NAME
                    FROM information_schema.STATISTICS
                    WHERE TABLE_SCHEMA = DATABASE()
                    AND TABLE_NAME = 'follows'
                    AND NON_UNIQUE = 0
                    AND INDEX_NAME != 'PRIMARY'
                    AND COLUMN_NAME IN ('follower_id', 'following_id')
                    GROUP BY INDEX_NAME
                    HAVING COUNT(DISTINCT COLUMN_NAME) = 2
                    ) AS existing_composite_unique_indexes
                </sqlCheck>
            </or>
        </preConditions>
        <addUniqueConstraint tableName="follows"
                             columnNames="follower_id, following_id"
                             constraintName="uk_follows_follower_following"/>
    </changeSet>

    <changeSet id="006c-create-follows-following-created-at-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="follows" indexName="idx_follows_following_created_at"/></not>
        </preConditions>
        <createIndex tableName="follows" indexName="idx_follows_following_created_at">
            <column name="following_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006d-create-follows-follower-created-at-index" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><indexExists tableName="follows" indexName="idx_follows_follower_created_at"/></not>
        </preConditions>
        <createIndex tableName="follows" indexName="idx_follows_follower_created_at">
            <column name="follower_id"/>
            <column name="created_at"/>
            <column name="id"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-create-likes-table" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="likes"/></not>
        </preConditions>
        <createTable tableName="likes">
            <column name="id" type="BINARY(16)"><constraints primaryKey="true" nullable="false"/></column>
            <column name="users_id" type="BINARY(16)"><constraints nullable="false" foreignKeyName="fk_likes_users" references="users(id)"/></column>
            <column name="posts_id" type="BINARY(16)"><constraints nullable="false" foreignKeyName="fk_likes_posts" references="posts(id)"/></column>
            <column name="created_at" type="DATETIME(6)"><constraints nullable="false"/></column>
            <column name="updated_at" type="DATETIME(6)"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="007b-add-likes-unique-constraint" author="theaprince001">
        <preConditions onFail="MARK_RAN">
            <or>
                <dbms type="!mysql"/>
                <sqlCheck expectedResult="0">
                    SELECT COUNT(*) FROM (
                    SELECT INDEX_NAME
                    FROM information_schema.STATISTICS
                    WHERE TABLE_SCHEMA = DATABASE()
                    AND TABLE_NAME = 'likes'
                    AND NON_UNIQUE = 0
                    AND INDEX_NAME != 'PRIMARY'
                    AND COLUMN_NAME IN ('users_id', 'posts_id')
                    GROUP BY INDEX_NAME
                    HAVING COUNT(DISTINCT COLUMN_NAME) = 2
                    ) AS existing_composite_unique_indexes
                </sqlCheck>
            </or>
        </preConditions>
        <addUniqueConstraint tableName="likes"
                             columnNames="users_id, posts_id"
                             constraintName="uk_likes_users_posts"/>
    </changeSet>

    <changeSet id="007c-create-likes-posts-id-index" author="theaprince001">
